{
  "realm": "iprody",
  "displayName": "iPrody",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator with full access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "MANAGER",
        "description": "Manager with management access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "TEACHER",
        "description": "Teacher with teaching access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "INTERN",
        "description": "Intern with limited access",
        "composite": false,
        "clientRole": false
      }
    ]
  },

  "groups": [
    {
      "name": "admin",
      "path": "/admin",
      "realmRoles": ["ADMIN"]
    },
    {
      "name": "manager",
      "path": "/manager",
      "realmRoles": ["MANAGER"]
    },
    {
      "name": "teacher",
      "path": "/teacher",
      "realmRoles": ["TEACHER"]
    },
    {
      "name": "intern",
      "path": "/intern",
      "realmRoles": ["INTERN"]
    }
  ],

  "users": [
    {
      "username": "admin",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/admin"],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEF_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "manager",
      "firstName": "Manager",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/manager"],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEF_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "teacher",
      "firstName": "Teacher",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/teacher"],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEF_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "intern",
      "firstName": "Intern",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/intern"],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEF_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],

  "clients": [
    {
      "clientId": "iprody-public-client",
      "name": "iPrody Public Client",
      "description": "Public OAuth client for service authentication",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:8081/*",
        "http://localhost:8082/*",
        "http://localhost:9080/*",
        "http://localhost:7080/*",
        "http://localhost:7090/*",
        "http://localhost:*/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:8081",
        "http://localhost:8082",
        "http://localhost:9080",
        "http://localhost:7080",
        "http://localhost:7090",
        "http://localhost:*"
      ],
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+",
        "oauth2.device.authorization.grant.enabled": "false",
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],

  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt"
  ],

  "authenticationFlows": [
    {
      "alias": "browser",
      "description": "Browser based authentication",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "priority": 10,
          "requirement": "ALTERNATIVE",
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-spnego",
          "priority": 20,
          "requirement": "DISABLED",
          "authenticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "priority": 25,
          "requirement": "ALTERNATIVE",
          "authenticatorFlow": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "flowAlias": "forms",
          "priority": 30
        }
      ]
    },
    {
      "alias": "forms",
      "description": "Username, password, otp and other auth forms.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "priority": 10,
          "requirement": "REQUIRED",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "direct grant",
      "description": "OpenID Connect Resource Owner Grant",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "priority": 10,
          "requirement": "REQUIRED",
          "authenticatorFlow": false
        },
        {
          "authenticator": "direct-grant-validate-password",
          "priority": 20,
          "requirement": "REQUIRED",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "registration",
      "description": "Registration flow",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "registration-page-form",
          "priority": 10,
          "requirement": "REQUIRED",
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "reset credentials",
      "description": "Reset credentials for a user if they forgot their password or something",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "reset-credentials-choose-user",
          "priority": 10,
          "requirement": "REQUIRED",
          "authenticatorFlow": false
        },
        {
          "authenticator": "send-reset-email",
          "priority": 20,
          "requirement": "REQUIRED",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "clients",
      "description": "Base authentication for clients",
      "providerId": "client-flow",
      "topLevel": true,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "client-secret",
          "priority": 10,
          "requirement": "ALTERNATIVE",
          "authenticatorFlow": false
        },
        {
          "authenticator": "client-jwt",
          "priority": 20,
          "requirement": "ALTERNATIVE",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "docker auth",
      "description": "Used by Docker clients to authenticate against the IDP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "docker-http-basic-authenticator",
          "priority": 10,
          "requirement": "REQUIRED",
          "authenticatorFlow": false
        }
      ]
    }
  ],

  "authenticatorConfig": [],
  "requiredActions": [],
  "browserFlow": "browser",
  "registrationFlow": "registration",
  "directGrantFlow": "direct grant",
  "resetCredentialsFlow": "reset credentials",
  "clientAuthenticationFlow": "clients",
  "dockerAuthenticationFlow": "docker auth",

  "keycloakVersion": "23.0",
  "userManagedAccessAllowed": false,
  "clientProfiles": {
    "profiles": []
  },
  "clientPolicies": {
    "policies": []
  }
}
